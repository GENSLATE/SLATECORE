{
  "$schema": "../../../node_modules/turbo/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/crates/**",
        "$TURBO_ROOT$/Cargo.toml",
        "$TURBO_ROOT$/Cargo.lock",
        "$TURBO_ROOT$/rust-toolchain.toml",
        "$TURBO_ROOT$/.config/cargo/**"
      ],
      "outputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/target/release/slatecore-launcher.exe"]
    }
  }
}
