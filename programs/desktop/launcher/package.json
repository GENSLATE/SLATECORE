{
  "name": "@genslate/launcher",
  "version": "0.1.0",
  "private": true,
  "description": "SLATECORE LAUNCHER by GENSLATE: the portable app launcher (Tauri 2 shell with a React UI).",
  "author": "GENSLATE",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "bun --bun vite",
    "build": "tauri build --no-bundle",
    "build:web": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --preload ./tests/setup/dom.preload.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@genslate/design-system": "workspace:*",
    "@genslate/tauri-bridge": "workspace:*",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-global-shortcut": "catalog:",
    "@tauri-apps/plugin-log": "catalog:",
    "@tauri-apps/plugin-opener": "catalog:",
    "@tauri-apps/plugin-os": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@genslate/config-typescript": "workspace:*",
    "@genslate/config-vite": "workspace:*",
    "@happy-dom/global-registrator": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
