{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least privilege for the launcher window: its own typed commands (app ids, folder and file names and vault names, never paths), event listening and the window theme. No dragging, moving or resizing, no shell, fs, opener, dialog or OS access from the webview.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-theme",
    "allow-run-action",
    "allow-get-context",
    "allow-list-apps",
    "allow-rescan",
    "allow-launch-app",
    "allow-open-app-folder",
    "allow-set-app-override",
    "allow-open-folder",
    "allow-open-config-file",
    "allow-set-setting",
    "allow-get-volume-info",
    "allow-set-telemetry-active",
    "allow-window-set-pinned",
    "allow-window-set-expanded",
    "allow-window-set-popup-open",
    "allow-window-hide",
    "allow-window-show",
    "allow-quit",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-change-password",
    "allow-vault-list",
    "allow-vault-import",
    "allow-vault-export",
    "allow-vault-open",
    "allow-vault-verify"
  ]
}
