{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 6,
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Actions stay pinned to commit SHAs with a version comment (config:best-practices).",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "ci"
    },
    {
      "description": "Tauri crates and their JavaScript twins move together.",
      "matchPackageNames": ["tauri", "tauri-*", "@tauri-apps/*"],
      "groupName": "tauri"
    },
    {
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"],
      "groupName": "react"
    },
    {
      "matchPackageNames": ["tailwindcss", "@tailwindcss/*"],
      "groupName": "tailwind css"
    }
  ]
}
