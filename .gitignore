# SUPERPOWERS FILES

docs/
.superpowers/

# GENSLATE INTERNAL FILES

.genslate/

# ─── Dependencies ─────────────────────────────────────────────────────
node_modules/

# ─── Build output and caches ──────────────────────────────────────────
dist/
out/
target/
coverage/
.turbo/
*.tsbuildinfo

# Tauri: regenerated by tauri-build on every cargo build.
programs/*/*/src-tauri/gen/
programs/*/*/src-tauri/permissions/autogenerated/

# ─── Packaged releases (keep the folders) ─────────────────────────────
release/*
!release/.gitkeep
!release/.archive/
release/.archive/*
!release/.archive/.gitkeep

# ─── Secrets & environment ────────────────────────────────────────────
.env
.env.*
!.env.example
**/credentials.toml
*.pem
*.key

# ─── Agent tools (personal / runtime) ─────────────────────────────────
.claude/settings.local.json
.claude/worktrees/
.claude/logs/*
!.claude/logs/.gitkeep
CLAUDE.local.md
.cursor/hooks/state/

# ─── Launcher runtime state (dev seed `other/launcher`; keep the folders)
programs/desktop/launcher/other/launcher/cache/*
!programs/desktop/launcher/other/launcher/cache/.gitkeep
programs/desktop/launcher/other/launcher/logs/*
!programs/desktop/launcher/other/launcher/logs/.gitkeep
programs/desktop/launcher/other/launcher/database/*
!programs/desktop/launcher/other/launcher/database/.gitkeep
programs/desktop/launcher/other/launcher/documents/qa/

# ─── Launcher dev installDir: keep the template, ignore what you drop in
programs/desktop/launcher/installDir/programs/**/*
!programs/desktop/launcher/installDir/programs/**/
!programs/desktop/launcher/installDir/programs/**/.gitkeep
programs/desktop/launcher/installDir/storage/**/*
!programs/desktop/launcher/installDir/storage/**/
!programs/desktop/launcher/installDir/storage/**/.gitkeep
programs/desktop/launcher/installDir/other/**/*
!programs/desktop/launcher/installDir/other/**/
!programs/desktop/launcher/installDir/other/**/.gitkeep

# ─── OS / editor noise ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
