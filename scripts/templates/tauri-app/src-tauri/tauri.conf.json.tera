{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "{{ title }}",
  "mainBinaryName": "slatecore-{{ name }}",
  "version": "../package.json",
  "identifier": "{{ identifier }}",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "beforeBuildCommand": "bun run build:web",
    "devUrl": "http://localhost:{{ port }}",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "{{ title }}",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": true,
        "backgroundColor": "#2e3440"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:{{ port + 1 }}",
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "category": "Utility",
    "shortDescription": "{{ description }}.",
    "longDescription": "{{ title }}: {{ description }}. A portable SLATECORE app by GENSLATE.",
    "publisher": "GENSLATE",
    "copyright": "GENSLATE. All rights reserved.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
