[package]
name = "genslate-{{ name }}"
description = "{{ title }} by GENSLATE (Tauri 2 shell)."
version.workspace = true
edition.workspace = true
rust-version.workspace = true
authors.workspace = true
license.workspace = true
publish.workspace = true
repository.workspace = true
default-run = "slatecore-{{ name }}"

[lib]
# `_lib` suffix avoids a name clash with the bin target on Windows (cargo#8519).
name = "genslate_{{ snake }}_lib"
crate-type = ["staticlib", "cdylib", "rlib"]

[[bin]]
# The shipped file is `slatecore-{{ name }}.exe`; the Cargo package keeps the GENSLATE namespace.
name = "slatecore-{{ name }}"
path = "src/main.rs"

[build-dependencies]
tauri-build.workspace = true

[dependencies]
genslate-{{ name }}-core.workspace = true
genslate-paths.workspace = true
log.workspace = true
serde.workspace = true
tauri = { workspace = true, features = ["common-controls-v6", "dynamic-acl"] }
tauri-plugin-log.workspace = true
tauri-plugin-opener.workspace = true
tauri-plugin-os.workspace = true
tauri-plugin-single-instance.workspace = true
thiserror.workspace = true

[lints]
workspace = true
