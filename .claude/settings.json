{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun scripts/commands/*)",
      "Bash(bun x --no-install turbo run *)",
      "Bash(bun x --no-install turbo ls *)",
      "Bash(bun x --no-install biome check *)",
      "Bash(bun x --no-install biome format *)",
      "Bash(bun x --no-install biome lint *)",
      "Bash(bun x --no-install cspell *)",
      "Bash(bun x --no-install knip *)",
      "Bash(bun x --no-install tsc --noEmit *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo fmt *)",
      "Bash(cargo build *)",
      "Bash(cargo doc *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny *)",
      "Bash(cargo machete *)",
      "Bash(rustfmt *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git grep *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:turborepo.dev)",
      "WebFetch(domain:base-ui.com)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:tailwind-variants.org)",
      "WebFetch(domain:v2.tauri.app)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:bun.com)",
      "WebFetch(domain:biomejs.dev)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:www.nordtheme.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:microsoft.github.io)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(bun add *)",
      "Bash(bun remove *)",
      "Bash(bun update *)",
      "Bash(cargo add *)",
      "Bash(cargo update *)",
      "Bash(bun run clean *)",
      "Bash(bun run package *)",
      "Bash(bun run version *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials.toml)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.npmrc)",
      "Read(**/storage/vault/**)",
      "Edit(**/storage/vault/**)",
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(rm -rf .git *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force)",
      "Bash(git push * -f)",
      "Bash(git * --no-verify*)",
      "Bash(cargo publish *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(node *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "PowerShell(npm *)",
      "PowerShell(npx *)",
      "PowerShell(pnpm *)",
      "PowerShell(yarn *)",
      "PowerShell(node *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git * --no-verify*)",
      "PowerShell(cargo publish *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.hook.ts"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-generated.hook.ts"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.hook.ts"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
