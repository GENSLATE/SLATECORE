# Normalise all text to LF in the repository (drift checks compare bytes).
* text=auto eol=lf

# Windows scripts keep CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.exe   binary
*.dll   binary
*.zip   binary
*.cab   binary

# Lockfiles: never merge by hand, collapse in diffs.
bun.lock   linguist-generated=true -diff
Cargo.lock linguist-generated=true -diff

# Generated design tokens and icons: edit packages/tokens/src, then run `bun run tokens`.
packages/tokens/src/generated/**                linguist-generated=true eol=lf
crates/design-tokens/src/generated/**           linguist-generated=true eol=lf
packages/design-system/src/icons/*.generated.ts linguist-generated=true eol=lf
