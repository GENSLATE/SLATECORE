# Keeps bulk, generated and private files out of Cursor's index, Tab and @ mentions.
# Gitignore syntax. Not a security boundary: terminal and MCP tools can still read these files.

# Dependencies and build output
node_modules/
target/
dist/
coverage/
.turbo/
release/

# Lockfiles (generated by bun and cargo)
bun.lock
Cargo.lock

# Generated sources (edit the source, run `bun run tokens`)
packages/tokens/src/generated/
crates/design-tokens/src/generated/
packages/design-system/src/icons/*.generated.ts
programs/*/*/src-tauri/gen/
programs/*/*/src-tauri/permissions/autogenerated/

# Private and user data
.env
.env.*
.genslate/
**/storage/vault/
programs/desktop/launcher/installDir/storage/
programs/desktop/launcher/other/launcher/cache/
programs/desktop/launcher/other/launcher/logs/
programs/desktop/launcher/other/launcher/database/
